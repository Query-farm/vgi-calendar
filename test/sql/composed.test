# name: test/sql/composed.test
# description: Composed examples — several cal functions combined in one query (schema-level example queries + composed agent-task graders)
# group: [vgi_calendar]

require-env VGI_CALENDAR_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'cal' AS cal (TYPE vgi, LOCATION '{VGI_CALENDAR_WORKER}');

# rrule + is_business_day + add_business_days + holiday_name: 'following' settlement roll
query TTT
WITH sched AS (SELECT r.seq, CAST(r.occurrence AS DATE) AS due FROM cal.main.rrule(TIMESTAMP '2026-01-01', 'FREQ=MONTHLY;BYMONTHDAY=1;COUNT=12') AS r) SELECT due, CASE WHEN cal.main.is_business_day(due) THEN due ELSE cal.main.add_business_days(due, 1) END AS settles_on, cal.main.holiday_name(due) AS holiday FROM sched ORDER BY seq;
----
2026-01-01	2026-01-02	New Year's Day
2026-02-01	2026-02-02	NULL
2026-03-01	2026-03-02	NULL
2026-04-01	2026-04-01	NULL
2026-05-01	2026-05-01	NULL
2026-06-01	2026-06-01	NULL
2026-07-01	2026-07-01	NULL
2026-08-01	2026-08-03	NULL
2026-09-01	2026-09-01	NULL
2026-10-01	2026-10-01	NULL
2026-11-01	2026-11-02	NULL
2026-12-01	2026-12-01	NULL

# rrule (BYMONTHDAY=-1) + is_business_day + negative add_business_days: 'preceding' payroll
query TT
WITH ends AS (SELECT r.seq, CAST(r.occurrence AS DATE) AS month_end FROM cal.main.rrule(TIMESTAMP '2026-01-31', 'FREQ=MONTHLY;BYMONTHDAY=-1;COUNT=12') AS r) SELECT month_end, CASE WHEN cal.main.is_business_day(month_end) THEN month_end ELSE cal.main.add_business_days(month_end, -1) END AS payday FROM ends ORDER BY seq;
----
2026-01-31	2026-01-30
2026-02-28	2026-02-27
2026-03-31	2026-03-31
2026-04-30	2026-04-30
2026-05-31	2026-05-29
2026-06-30	2026-06-30
2026-07-31	2026-07-31
2026-08-31	2026-08-31
2026-09-30	2026-09-30
2026-10-31	2026-10-30
2026-11-30	2026-11-30
2026-12-31	2026-12-31

# business_days aggregated per month joined to holidays aggregated per month
query TIT
WITH bd AS (SELECT date_trunc('month', date) AS month, count(*) AS business_days FROM cal.main.business_days(DATE '2026-01-01', DATE '2026-12-31', country := 'US') GROUP BY ALL), hol AS (SELECT date_trunc('month', date) AS month, string_agg(name, ', ' ORDER BY date) AS holidays FROM cal.main.holidays(2026, country := 'US') GROUP BY ALL) SELECT strftime(bd.month, '%Y-%m') AS month, bd.business_days, hol.holidays FROM bd LEFT JOIN hol USING (month) ORDER BY bd.month;
----
2026-01	20	New Year's Day, Martin Luther King Jr. Day
2026-02	19	Washington's Birthday
2026-03	22	NULL
2026-04	22	NULL
2026-05	20	Memorial Day
2026-06	21	Juneteenth National Independence Day
2026-07	22	Independence Day (observed), Independence Day
2026-08	21	NULL
2026-09	21	Labor Day
2026-10	21	Columbus Day
2026-11	19	Veterans Day, Thanksgiving Day
2026-12	22	Christmas Day

# two holidays() calls joined on date: shared US/GB closures
query TTT
SELECT us.date, us.name AS us_holiday, gb.name AS gb_holiday FROM cal.main.holidays(2026, country := 'US') AS us JOIN cal.main.holidays(2026, country := 'GB') AS gb ON us.date = gb.date ORDER BY us.date;
----
2026-01-01	New Year's Day	New Year's Day
2026-05-25	Memorial Day	Spring Bank Holiday
2026-12-25	Christmas Day	Christmas Day

# holidays() + easter(): Easter-anchored German holidays
query TTI
SELECT h.date, h.name, h.date - cal.main.easter(2026) AS days_from_easter FROM cal.main.holidays(2026, country := 'DE') AS h WHERE abs(h.date - cal.main.easter(2026)) <= 60 ORDER BY h.date;
----
2026-04-03	Good Friday	-2
2026-04-06	Easter Monday	1
2026-05-01	Labor Day	26
2026-05-14	Ascension Day	39
2026-05-25	Pentecost Monday	50
